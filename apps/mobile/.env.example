# Base URL of the Jelementi web reader.
# Phase 0 points at the local SvelteKit dev server; production uses
# https://jelementi.quz.ma once the Cloudflare deployment lands (Phase 2).
EXPO_PUBLIC_SITE_URL=http://localhost:5173

# Article route the shell opens by default (same route served by the web app).
EXPO_PUBLIC_ARTICLE_PATH=/articles/tristan-da-cunha
