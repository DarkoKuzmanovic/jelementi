{
  "name": "jelementi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.12 <21 || >=21.7"
  },
  "scripts": {
    "dev:web": "pnpm content:build && pnpm --filter @jelementi/web dev",
    "build:web": "pnpm content:build && pnpm --filter @jelementi/web build",
    "preview:web": "pnpm build:web && pnpm exec wrangler dev --local --ip 127.0.0.1 --persist-to /tmp/jelementi-wrangler-preview",
    "deploy:web": "pnpm verify:deploy && pnpm exec wrangler deploy",
    "verify:web": "tsx scripts/verify-web.ts",
    "verify:reader:assets": "tsx scripts/reader-assets.ts",
    "verify:worker": "tsx scripts/verify-worker.ts",
    "verify:wrangler": "tsx scripts/verify-deploy.ts",
    "verify:remote": "tsx scripts/verify-remote.ts",
    "media:upload": "tsx scripts/media-cli.ts upload",
    "media:verify": "tsx scripts/media-cli.ts verify",
    "verify:deploy": "pnpm format && pnpm lint && pnpm typecheck && pnpm content:validate && pnpm test && pnpm test:studio:browser && pnpm build:web && pnpm test:reader:browser && pnpm verify:web && pnpm verify:reader:assets && pnpm verify:wrangler && pnpm verify:worker && pnpm media:verify",
    "content:validate": "tsx scripts/content-cli.ts validate",
    "content:build": "tsx scripts/content-cli.ts build",
    "content:watch": "tsx scripts/content-cli.ts watch",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:reader:browser": "tsx scripts/reader-browser-acceptance.ts",
    "test:studio:browser": "tsx scripts/studio-browser-acceptance.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@jelementi/article-model": "workspace:*",
    "@jelementi/content-compiler": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.22.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
