# Public base URL used to resolve relative canonical media keys.
PUBLIC_MEDIA_BASE_URL=http://localhost:5173/media/

# Studio/GitHub runtime bindings are declared symmetrically in
# `wrangler.jsonc` and `wrangler.m2.jsonc`: non-secret identifiers as `vars`,
# the GitHub App private key in `secrets.required`. Their TypeScript shape is
# generated by `wrangler types` into `worker-configuration.d.ts` — never
# handwritten. Local overrides/secrets go into `.dev.vars` (gitignored). The
# committed placeholders must be replaced at Checkpoint A (GitHub App
# provisioning) and Checkpoint B (Cloudflare Access application) before any
# Studio deployment; missing configuration fails closed.
#ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
#ACCESS_AUD=<access-application-aud-tag>
#ALLOWED_OPERATOR_EMAIL=darko@example.com
#GITHUB_APP_ID=<github-app-id>
#GITHUB_APP_CLIENT_ID=<github-app-client-id>
#GITHUB_INSTALLATION_ID=<github-app-installation-id>
#GITHUB_REPO_OWNER=DarkoKuzmanovic
#GITHUB_REPO_NAME=jelementi
#PRODUCTION_ORIGIN=https://jelementi.quz.ma
#GITHUB_APP_PRIVATE_KEY=<pem-secret-in-.dev.vars-only>
