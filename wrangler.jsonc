{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jelementi-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "jelementi.quz.ma",
      "custom_domain": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "jelementi-media",
    },
  ],
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY"],
  },
  "vars": {
    "ACCESS_AUD": "b8ab323d9d804dd26a17dafe9abbdd519e93d146cb0a7aabbdbe002b7d221735",
    "ACCESS_TEAM_DOMAIN": "https://quzma.cloudflareaccess.com",
    "ALLOWED_OPERATOR_EMAIL": "darko.kuzmanovic@gmail.com",
    "GITHUB_APP_CLIENT_ID": "Iv23lijel88VeotOZ5at",
    "GITHUB_APP_ID": "4617065",
    "GITHUB_INSTALLATION_ID": "154254277",
    "GITHUB_REPO_NAME": "jelementi",
    "GITHUB_REPO_OWNER": "DarkoKuzmanovic",
    "PRODUCTION_ORIGIN": "https://jelementi.quz.ma",
    "PUBLIC_MEDIA_BASE_URL": "https://media.jelementi.quz.ma/",
  },
}
